# ReForge Configuration
# =====================

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Database
DATABASE_URL=sqlite+aiosqlite:///./reforge.db

# GitHub (optional - not required for local/demo usage)
GITHUB_TOKEN=

# Migration Settings
MAX_REPAIR_ATTEMPTS=3

# Demo Mode (set to true to enable deterministic fallback when LLM is unavailable)
DEMO_MODE=true

# Upload & Projects Directories
UPLOAD_DIR=./uploads
PROJECTS_DIR=./projects
